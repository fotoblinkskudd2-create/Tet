# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tet_db

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production

# OpenAI Configuration (for fact extraction)
OPENAI_API_KEY=your-openai-api-key

# News Sources Configuration
SCAN_INTERVAL_MINUTES=30

# Norwegian News Sources
NORWAY_NEWS_SOURCES=https://www.nrk.no/toppsaker.rss,https://www.vg.no/rss/feed/,https://www.aftenposten.no/rss

# US News Sources
USA_NEWS_SOURCES=https://feeds.npr.org/1001/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml

# World News Sources
WORLD_NEWS_SOURCES=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.theguardian.com/world/rss
