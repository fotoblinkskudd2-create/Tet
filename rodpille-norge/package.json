{
  "name": "rodpille-norge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:web": "turbo dev --filter=@rodpille/web",
    "dev:mobile": "turbo dev --filter=@rodpille/mobile",
    "dev:admin": "turbo dev --filter=@rodpille/admin",
    "db:migrate": "supabase db push",
    "db:generate": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > packages/database/src/types.ts",
    "deploy:web": "turbo deploy --filter=@rodpille/web",
    "deploy:mobile": "eas build --platform all"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.2.0"
}
